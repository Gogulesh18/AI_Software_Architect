# Copy to .env and fill in. Committed .env.example only — never commit .env itself.

# ---- LLM (required) ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# Optional second provider, wired through the same app/llm interface (see ARCHITECTURE.md).
# OPENAI_API_KEY=

# ---- Embeddings (local by default, no key needed) ----
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Job runner ----
# "inprocess" = dev default (no Redis/Celery needed). "celery" = prod mode (docker-compose.yml).
JOB_RUNNER=inprocess

# ---- Database ----
# Dev default: SQLite, no setup required.
DATABASE_URL=sqlite:///./dev.db
# Prod (set automatically by docker-compose.yml, shown here for reference):
# DATABASE_URL=postgresql+psycopg://architect:architect@postgres:5432/ai_architect

# ---- Prod-only: Redis / Celery (docker-compose.yml sets these; leave blank for local dev) ----
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
POSTGRES_USER=architect
POSTGRES_PASSWORD=architect
POSTGRES_DB=ai_architect

# ---- Vector store ----
CHROMA_PERSIST_DIR=./.data/chroma

# ---- Ingestion ----
# Where cloned repos / extracted ZIPs are staged during analysis.
REPO_WORKSPACE_DIR=./.data/repos

# ---- API / CORS ----
CORS_ORIGINS=http://localhost:5173
